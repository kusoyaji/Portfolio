---
const jobs = [
  {
    title: 'Solutions Architect',
    company: 'Voom Digital',
    url: '#',
    period: 'Oct 2025 — Present',
    points: [
      'Built a production AI platform processing conversations across 8+ channels with 7 integrated AI models and autonomous function calling.',
      'Designed unified MCP servers aggregating multiple Zoho accounts into a single Claude AI-compatible interface.',
      'Engineered hybrid RAG search (6+ strategies), visual product matching, AI voice responses (30 TTS voices), and a 16-page admin portal.',
    ],
  },
  {
    title: 'Software Engineer Intern',
    company: 'Orange Morocco',
    url: '#',
    period: 'Mar 2025 — Sep 2025',
    points: [
      'Digitalized a laboratory automation system ("FabLab") — full-stack design, implementation, and deployment.',
      'Managed complete development lifecycle from requirements to production.',
    ],
  },
  {
    title: 'Freelance Developer',
    company: 'Independent',
    url: '#',
    period: 'Ongoing',
    points: [
      'Delivered 7+ professional websites across multiple industries with end-to-end architecture, UX/UI, and deployment.',
      'Managed deployment infra via Railway and Docker, including DNS configuration.',
    ],
  },
];
---

<section id="experience" class="py-16 lg:py-24 px-6 lg:px-12 max-w-screen-xl mx-auto">
  <h2 class="numbered-heading mb-8" data-animate>
    <span class="mono">02.</span> Where I've Worked
  </h2>

  <div class="max-w-2xl space-y-8">
    {jobs.map((job) => (
      <div data-animate class="relative pl-6 side-line">
        <h3 class="text-lg font-semibold text-white">
          {job.title}
          <span class="text-accent"> @ {job.company}</span>
        </h3>
        <p class="mono text-xs mt-1 mb-4 opacity-70">{job.period}</p>
        <ul class="space-y-2">
          {job.points.map((point) => (
            <li class="flex gap-3 text-sm text-text-dim leading-relaxed">
              <span class="text-accent shrink-0 mt-1 text-xs">▸</span>
              {point}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

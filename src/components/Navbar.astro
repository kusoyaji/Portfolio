---
const links = [
  { label: 'About', href: '#about' },
  { label: 'Work', href: '#experience' },
  { label: 'Projects', href: '#projects' },
  { label: 'Contact', href: '#contact' },
];
---

<header id="navbar" class="fixed top-0 w-full z-50 transition-all duration-300 px-6 lg:px-12">
  <nav class="max-w-screen-xl mx-auto flex items-center justify-between h-16 lg:h-[70px]">
    <a href="#" class="flex items-center gap-2.5 hover:opacity-80 transition-opacity">
      <img
        src="/images/profile.jpg"
        alt="Mehdi Boudar"
        class="w-8 h-8 rounded-full object-cover ring-2 ring-accent/40"
      />
      <span class="text-accent font-mono text-lg font-semibold hidden sm:inline">M.</span>
    </a>

    <div class="hidden md:flex items-center gap-1">
      {links.map((link, i) => (
        <a href={link.href} class="px-3 py-2 font-mono text-[13px] text-text-dim hover:text-accent transition-colors">
          <span class="text-accent mr-1">0{i + 1}.</span>{link.label}
        </a>
      ))}
      <a href="/resume.pdf" class="btn-primary ml-4 !py-2 !px-4" target="_blank" rel="noopener noreferrer">
        Resume
      </a>
    </div>

    <button id="mobile-toggle" class="md:hidden text-text-dim hover:text-accent transition-colors" aria-label="Menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile -->
  <div id="mobile-menu" class="hidden md:hidden bg-bg-light rounded-lg border border-bg-lighter p-6 mt-2 mx-2">
    <div class="flex flex-col gap-4">
      {links.map((link, i) => (
        <a href={link.href} class="font-mono text-sm text-text-dim hover:text-accent transition-colors text-center">
          <span class="text-accent mr-1">0{i + 1}.</span>{link.label}
        </a>
      ))}
      <a href="/resume.pdf" class="btn-primary justify-center mt-2" target="_blank" rel="noopener noreferrer">Resume</a>
    </div>
  </div>
</header>

<style>
  .navbar-scrolled {
    background: rgba(10, 25, 47, 0.85);
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px -10px rgba(2, 12, 27, 0.7);
  }
</style>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach(l => l.addEventListener('click', () => menu?.classList.add('hidden')));
</script>

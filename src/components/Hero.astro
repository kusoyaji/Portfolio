---
---

<section class="relative min-h-screen flex items-center overflow-hidden">
  <!-- Ambient background layer -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-dots"></div>
    <div class="absolute -top-[20%] -right-[10%] w-[800px] h-[800px] glow-accent rounded-full"></div>
    <div class="absolute top-[60%] -left-[15%] w-[600px] h-[600px] glow-blue rounded-full"></div>
    <div class="absolute top-[25%] left-[45%] w-[400px] h-[400px] glow-purple rounded-full opacity-60"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 px-6 lg:px-12 max-w-screen-xl mx-auto w-full">
    <div class="max-w-2xl pt-24 lg:pt-0">
      <p class="mono mb-5" data-animate>Hi, my name is</p>

      <h1 class="heading-lg text-white mb-3" data-animate>
        Mehdi Boudar.
      </h1>

      <h2 class="heading-lg !text-text-dim mb-6" data-animate>
        I build intelligent systems.
      </h2>

      <p class="max-w-lg text-text-dim leading-relaxed mb-10" data-animate>
        Software Engineer & AI Solutions Architect specializing in
        production-grade AI orchestration, multi-model architectures, and
        enterprise integrations. Currently building at
        <a href="#experience" class="inline-link">Voom Digital</a>.
      </p>

      <div class="flex flex-wrap items-center gap-4" data-animate>
        <a href="#projects" class="btn-primary">
          See my work
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <a href="mailto:meehdi99@gmail.com" class="btn-primary !border-text-dim/30 !text-text-dim hover:!border-accent hover:!text-accent">
          Get in touch
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2" data-animate>
    <span class="font-mono text-[10px] text-text-dim/40 tracking-widest uppercase">Scroll</span>
    <div class="w-5 h-8 border border-text-dim/20 rounded-full flex justify-center pt-2">
      <div class="w-0.5 h-2 bg-accent/60 rounded-full scroll-indicator"></div>
    </div>
  </div>
</section>

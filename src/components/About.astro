---
const skills = [
  'Java 21', 'Spring Boot', 'Angular', 'TypeScript',
  'PostgreSQL', 'pgvector', 'Redis', 'Docker',
  'RAG Pipelines', 'Claude AI', 'Gemini AI', 'MCP Servers',
];
---

<section id="about" class="relative py-16 lg:py-24 px-6 lg:px-12 max-w-screen-xl mx-auto">
  <!-- Ambient glow -->
  <div class="absolute -top-[10%] -left-[15%] w-[500px] h-[500px] glow-blue rounded-full pointer-events-none" aria-hidden="true"></div>

  <h2 class="numbered-heading mb-8" data-animate>
    <span class="mono">01.</span> About Me
  </h2>

  <div class="grid lg:grid-cols-[3fr_2fr] gap-8 lg:gap-12" data-animate>
    <div class="space-y-4 text-text-dim leading-relaxed">
      <p>
        I'm a State Engineer in Computer Science from
        <span class="text-white">EMSI</span>, based in Rabat/Casablanca.
        I build complex systems at the intersection of enterprise software
        and cutting-edge AI.
      </p>
      <p>
        At <span class="text-white">Voom Digital</span>, I architect a production AI
        customer service platform that handles conversations across 8+ channels
        using 7 AI models — with autonomous function calling,
        hybrid RAG search, and voice responses.
      </p>
      <p>
        Previously, I built a lab automation system at
        <span class="text-white">Orange Morocco</span> and have delivered
        <span class="text-white">7+ websites</span> as a freelancer.
      </p>

      <p class="text-sm mt-6">Technologies I work with:</p>
    </div>

    <!-- Certifications card -->
    <div class="space-y-4">
      <div class="card">
        <p class="mono text-xs mb-3 opacity-70">Certifications</p>
        <div class="space-y-3">
          <div class="flex items-start gap-3">
            <span class="text-accent mt-0.5 text-xs">▸</span>
            <span class="text-text text-sm">Oracle Certified Professional — Java SE 17</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-accent mt-0.5 text-xs">▸</span>
            <span class="text-text text-sm">Oracle Database SQL Certified Associate</span>
          </div>
        </div>
      </div>
      <div class="card">
        <p class="mono text-xs mb-3 opacity-70">Languages</p>
        <div class="text-text-dim text-sm space-y-1">
          <p>Arabic <span class="text-text-dim/50">— Native</span></p>
          <p>English <span class="text-text-dim/50">— Bilingual</span></p>
          <p>French <span class="text-text-dim/50">— Professional</span></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Skills grid -->
  <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-2 mt-6 max-w-2xl" data-stagger>
    {skills.map((skill) => (
      <li class="flex items-center gap-2 font-mono text-[13px] text-text-dim">
        <span class="text-accent text-xs">▸</span> {skill}
      </li>
    ))}
  </ul>
</section>
